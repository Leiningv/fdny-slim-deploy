# fdny-slim configuration — copy to config.env and fill in.
# NEVER commit real credentials. All values below are placeholders.

# Free Broadcastify account (https://www.broadcastify.com) — the system logs in
# and uses the web player's tokenized HLS stream URLs (no Premium needed).
# Set the real login on the host only. Never commit it.
BROADCASTIFY_USER=
BROADCASTIFY_PASS=

# Whisper model: tiny.en (fastest, free) or base.en (more accurate, still free)
WHISPER_MODEL=tiny.en
# Skip segments quieter than this RMS before whisper (0 disables the gate)
RMS_MIN=350

# WAHA - shared server (same instance as Eyesight), linked number +1 929-617-5861.
WAHA_URL=https://eyesight-waha.onrender.com
# API key: set the real value on the host only. Never commit it.
WAHA_API_KEY=
# "FD - BROOKLYN/SULLIVAN" group (5861 is owner)
WAHA_CHAT_ID=120363402289265018@g.us
WAHA_SESSION=default

# Broadcastify feed IDs (defaults work; override only if a feed changes)
FEED_HATZOLAH=7392
FEED_SULLIVAN=32727

# Segmenting: seconds per segment / ring size (pairs are transcribed for boundary coverage)
SEG_SECONDS=20
SEG_WRAP=6
# Dedup window for repeat alerts of the same incident
DEDUP_SECONDS=1800
# Where segment WAVs + dedup state are written (rotating ring, disk never grows)
SEG_DIR=./segments

# Web status server port (Render sets PORT automatically)
PORT=10000
# Public URL of this service - enables the self-keepalive ping (Render sets
# RENDER_EXTERNAL_URL automatically)
RENDER_EXTERNAL_URL=
# Archived speech clips for the status page (per feed)
ARCHIVE_KEEP=10
